# ===================================================================
# WorkLog Environment Configuration (Vercel + Firebase Console)
# ===================================================================

# 1. Google Gemini AI (Required for AI enhancement & voice transcription)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Firebase Project Credentials (Required when deploying to your own Firebase project)
# From Firebase Console -> Project Settings -> General -> Your Apps -> Web App config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# 3. Server Configuration (Optional)
PORT=3000
APP_URL=http://localhost:3000
